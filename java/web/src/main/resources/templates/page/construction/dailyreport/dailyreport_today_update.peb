            // 중복 방지: 우측에 이미 존재하지 않으면 추가
            const existing = rightMaterialGrid.getData().map(row => row.rsce_cd);
            const newRows = selectedRows
                            .filter(row => !existing.includes(row.rsce_cd))
                            .map(row => ({ ...row }));

            if (Array.isArray(oriFilterM)) {
                const selectedIds = selectedRows.map(r => r.rsce_cd);
                oriFilterM = oriFilterM.filter(item => !selectedIds.includes(item.rsce_cd));
            }

            if (newRows.length > 0) {
                newRows.forEach(row => {
                    rightMaterialGrid.prependRow({ ...row }); // 복제본 삽입
                });

                //  좌측 선택 행 삭제
                leftMaterialGrid.getCheckedRowKeys().forEach(key => leftMaterialGrid.removeRow(key));
            }

            leftMaterialGrid.uncheckAll();
        });

        // 제거 버튼 클릭 시
        document.getElementById('btnRemoveMaterial').addEventListener('click', () => {
            const selectedRows = rightMaterialGrid.getCheckedRows();
            if (selectedRows.length === 0) {
                gaiaCommon.customAlert("제거할 데이터를 선택하세요.");
                return;
            }

            // 중복 방지: 좌측에 이미 존재하지 않으면 추가
            const existing = leftMaterialGrid.getData().map(row => row.rsce_cd);
            const newRows = selectedRows
                    .filter(row => !existing.includes(row.rsce_cd))
                    .map(row => ({ ...row }));

            if (Array.isArray(oriFilterM)) {
                newRows.forEach(row => {
                    const existsInOri = oriFilterM.some(a => a.rsce_cd === row.rsce_cd);
                    if (!existsInOri) {
                        oriFilterM.push({
                            govsply_mtrl_yn: row.govsply_mtrl_yn,
                            rsce_cd: row.rsce_cd,
                            rsce_nm: row.rsce_nm,
                            spec_nm: row.spec_nm,
                            unit: row.unit,
                            total_qty: row.total_qty,
                            actual_qty: row.actual_qty,
                            acmtl_qty: row.acmtl_qty,
                            remndr_qty: row.remndr_qty,
                            rsce_tp_cd: row.rsce_tp_cd,
                            cntrct_chg_id: row.cntrct_chg_id,
                            manual_yn: row.manual_yn,
                            rsce_sno: row.rsce_sno,
                            ori_qty: row.ori_qty
                        });
                    }
                });
            }

            if (newRows.length > 0) {
                newRows.forEach(row => leftMaterialGrid.prependRow({ ...row }));
                rightMaterialGrid.getCheckedRowKeys().forEach(key => rightMaterialGrid.removeRow(key));
            }

            rightMaterialGrid.uncheckAll();
        });

        // ===== Expenses Grid =====
        const expensesColumns = [
            { header: '장비코드', name: 'rsce_cd', align: 'center', width: 120},
            { header: '장비명', name: 'rsce_nm', align: 'center', },
            { header: '규격', name: 'spec_nm', align: 'right', width: 80 },
            { header: '단위', name: 'unit', align: 'center',},
            { header: '총수량', name: 'total_qty', align: 'right',},
            { header: '금일수량', name: 'actual_qty', align: 'right',},
            {
                header: '금일누계',
                name: 'acmtl_qty',
                align: 'right',
                width: 150,
                formatter: ({ row }) =>
                    (Number(row.ori_qty || 0) + Number(row.actual_qty || 0)).toFixed(2)
            },
            { header: '잔여', name: 'remndr_qty', align: 'right', },
            { header: 'rsce_tp_cd', name: 'rsce_tp_cd', hidden: true },
            { header: 'cntrct_chg_id', name: 'cntrct_chg_id', hidden: true },
            { header: 'manual_yn', name: 'manual_yn', hidden: true },
            { header: 'rsce_sno', name: 'rsce_sno', hidden: true },
            { header: 'ori_qty', name: 'ori_qty', hidden: true }
        ];

        // 좌측(전체 리스트) 그리드
        const leftExpensesGrid = new tui.Grid({
            el: document.getElementById('leftExpensesGrid'),
            bodyHeight: 250,
            rowHeaders: ['checkbox'],
            columns: expensesColumns,
            data: [],
            scrollX: true,
            scrollY: true,
            columnOptions: { resizable: true },
        });

        // 우측(선택된 리스트) 그리드
        const rightExpensesColumns = makeEditableColumns(expensesColumns);
        const rightExpensesGrid = new tui.Grid({
            el: document.getElementById('rightExpensesGrid'),
            bodyHeight: 250,
            rowHeaders: ['checkbox'],
            columns: rightExpensesColumns,
            data: [],
            scrollX: true,
            scrollY: true,
            columnOptions: { resizable: true },
        });
        bindQuantityChangeHandler(rightExpensesGrid);

        // 추가 버튼 클릭 시
        document.getElementById('btnAddExpenses').addEventListener('click', () => {
            const selectedRows = leftExpensesGrid.getCheckedRows();
            if (selectedRows.length === 0) {
                gaiaCommon.customAlert("이동할 데이터를 선택하세요.");
                return;
            }

            // 중복 방지: 우측에 이미 존재하지 않으면 추가
            const existing = rightExpensesGrid.getData().map(row => row.rsce_cd);
            const newRows = selectedRows
                            .filter(row => !existing.includes(row.rsce_cd))
                            .map(row => ({ ...row }));

            if (Array.isArray(oriFilterE)) {
                const selectedIds = selectedRows.map(r => r.rsce_cd);
                oriFilterE = oriFilterE.filter(item => !selectedIds.includes(item.rsce_cd));
            }

            if (newRows.length > 0) {
                newRows.forEach(row => {
                    rightExpensesGrid.prependRow({ ...row }); // 복제본 삽입
                });

                //  좌측 선택 행 삭제
                leftExpensesGrid.getCheckedRowKeys().forEach(key => leftExpensesGrid.removeRow(key));
            }

            leftExpensesGrid.uncheckAll();
        });

        // 제거 버튼 클릭 시
        document.getElementById('btnRemoveExpenses').addEventListener('click', () => {
            const selectedRows = rightExpensesGrid.getCheckedRows();
            if (selectedRows.length === 0) {
                gaiaCommon.customAlert("제거할 데이터를 선택하세요.");
                return;
            }

            // 중복 방지: 좌측에 이미 존재하지 않으면 추가
            const existing = leftExpensesGrid.getData().map(row => row.rsce_cd);
            const newRows = selectedRows
                    .filter(row => !existing.includes(row.rsce_cd))
                    .map(row => ({ ...row }));

            if (Array.isArray(oriFilterE)) {
                newRows.forEach(row => {
                    const existsInOri = oriFilterE.some(a => a.rsce_cd === row.rsce_cd);
                    if (!existsInOri) {
                        oriFilterE.push({
                            rsce_cd: row.rsce_cd,
                            rsce_nm: row.rsce_nm,
                            spec_nm: row.spec_nm,
                            unit: row.unit,
                            total_qty: row.total_qty,
                            actual_qty: row.actual_qty,
                            acmtl_qty: row.acmtl_qty,
                            remndr_qty: row.remndr_qty,
                            rsce_tp_cd: row.rsce_tp_cd,
                            cntrct_chg_id: row.cntrct_chg_id,
                            manual_yn: row.manual_yn,
                            rsce_sno: row.rsce_sno,
                            ori_qty: row.ori_qty
                        });
                    }
                });
            }

            if (newRows.length > 0) {
                newRows.forEach(row => leftExpensesGrid.prependRow({ ...row }));
                rightExpensesGrid.getCheckedRowKeys().forEach(key => rightExpensesGrid.removeRow(key));
            }

            rightExpensesGrid.uncheckAll();
        });

        /**
         * editable 컬럼을 복제해 반환
         * @param {Array} columns - 원본 컬럼 배열
         * @param {string} editableName - 편집 가능한 컬럼명 (예: 'actual_qty')
         */
        function makeEditableColumns(columns, editableName = 'actual_qty') {
          return columns.map(col => {
            if (col.name === editableName) {
              return {
                ...col,
                editor: {
                  type: 'text',
                  options: { inputType: 'number' }
                },
                validation: {
                  dataType: 'number',
                  required: true,
                  validatorFn: (value) => !isNaN(value)
                }
              };
            }
            return { ...col, editable: false };
          });
        }

        /**
         * 숫자 변경 시 잔여(remndr_qty), 누계(acmtl_qty) 자동 계산
         * @param {tui.Grid} grid - 대상 그리드 객체
         */
        function bindQuantityChangeHandler(grid) {
          grid.on('afterChange', (ev) => {
            ev.changes.forEach(change => {
              const { rowKey, columnName, value } = change;
              if (columnName === 'actual_qty') {
                const row = grid.getRow(rowKey);
                const oriQty = Number(row.ori_qty || 0);
                const totalQty = Number(row.total_qty || 0);
                const actualQty = Number(value || 0);

                // 잔여(remndr_qty) = total_qty - (ori_qty + actual_qty)
                const remndrQty = totalQty - (oriQty + actualQty);

                grid.setValue(rowKey, 'remndr_qty', remndrQty.toFixed(2), false);
              }
            });
          });
        }

        // 체킹되어 있는 데이터 가져옴
        function getCheckedRows(grid) {
            return grid.getCheckedRows() || [];
        }
        // 액티비티 서버 전송용으로 가공
        function mapActivityRowsToList(rows, cntrctNo, dailyReportId, workDtType) {
            return rows.map(row => ({
                cntrctNo: cntrctNo ?? null,
                dailyReportId: dailyReportId ?? null,
                dailyActivityId: row.daily_activity_id ?? null,
                wbsCd: row.wbs_cd ?? null,
                activityId: row.activity_id ?? null,
                activityNm: row.activity_nm ?? null,
                workDtType: workDtType ?? null,
                planBgnDate: row.plan_start ?? null,
                planEndDate: row.plan_finish ?? null,
                planReqreDaynum: row.plan_reqre_daynum ?? 0,
                actualBgnDate: row.actual_bgn_date ?? null,
                actualEndDate: row.actual_end_date ?? null,
                actualReqreDaynum: row.actual_reqre_daynum ?? 0,
                todayExeRate: row.today_bohal ?? 0,
                cntrctChgId: row.cntrct_chg_id ?? null,
                revisionId: row.revision_id ?? null,
                dltYn: row.dlt_yn ?? "N",
                todayPlanRate: row.today_plan_rate
            }));
        }

        // 자원 서버 전송용으로 가공
        function mapResourceRowsToList(rows, cntrctNo, dailyReportId) {
            return rows.map((row) => ({
                cntrctNo: cntrctNo ?? null,
                dailyReportId: dailyReportId ?? null,
                rsceTpCd: row.rsce_tp_cd ?? null,
                rsceSno: row.rsce_sno ?? null ,
                rsceCd: row.rsce_cd ?? null,
                totalQty: parseFloat(row.total_qty ?? 0),
                planQty: parseFloat(row.plan_qty ?? 0),
                actualQty: parseFloat(row.actual_qty ?? 0),
                acmtlQty: parseFloat(
                    (Number(row.actual_qty ?? 0) + Number(row.ori_qty ?? 0)).toFixed(2)
                ),
                remndrQty: parseFloat(row.remndr_qty ?? 0),
                govsplyMtrlYn: row.govsply_mtrl_yn ?? null,
                mainRsceDsply: row.main_rsce_dsply ?? null,
                cntrctChgId: row.cntrct_chg_id ?? null,
                dltYn: row.dlt_yn ?? "N",
                manualYn: row.manual_yn ?? "N"
            }));
        }
        // 원본과 비교해서 사라진 항목 dlt_yn : Y 처리
        function mergeDeletedItems(originList, currentList, keyName = 'activity_id') {
            const currentIds = new Set(currentList.map(item => item[keyName]));
            const deletedItems = originList
                .filter(item => !currentIds.has(item[keyName]))
                .map(item => ({
                    ...item,
                    dlt_yn: 'Y'
                }));
            return [...currentList, ...deletedItems];
        }

        // 액티비티 키워드 검색 필터링
        function filterActivity() {
            const sDate = $('#sDate').val();
            const eDate = $('#eDate').val();
            const keyword = $('#searchText').val().trim().toLowerCase();

            // 원본 데이터를 기반으로 필터링
            const filtered = oriFilterAct.filter(row => {
                // 날짜 조건
                let dateMatch = true;
                if (sDate) dateMatch = new Date(row.plan_start) >= new Date(sDate);
                if (dateMatch && eDate) dateMatch = new Date(row.plan_finish) <= new Date(eDate);
                // 키워드 조건
                let keywordMatch = true;
                if (keyword) {
                    const pathNm = (row.path_nm || '').toLowerCase();
                    const actNm = (row.activity_nm || '').toLowerCase();
                    keywordMatch = pathNm.includes(keyword) || actNm.includes(keyword);
                }

                return dateMatch && keywordMatch;
            });

            activityGrid.resetData(filtered);
        }

        // 인력 키워드 검색 필터링
        function filterLabor() {
            const keyword = $('#laborSearchText').val().trim().toLowerCase();

            // 원본 데이터를 기반으로 필터링
            const filtered = oriFilterL.filter(row => {
                // 키워드 조건
                let keywordMatch = true;
                if (keyword) {
                    const rsceNm = (row.rsce_nm || '').toLowerCase();
                    const specNm = (row.spec_nm || '').toLowerCase();
                    keywordMatch = rsceNm.includes(keyword) || specNm.includes(keyword);
                }

                return keywordMatch;
            });

            leftLaborGrid.resetData(filtered);
        }

        // 자재 키워드 검색 필터링
        function filterMaterial() {
            const keyword = $('#materialSearchText').val().trim().toLowerCase();
            const supplyType = $('#matSupply').val(); // 전체 / 관급 / 사급

            // 원본 데이터를 기반으로 필터링
            const filtered = oriFilterM.filter(row => {
                // 키워드 필터
                let keywordMatch = true;
                if (keyword) {
                    const rsceNm = (row.rsce_nm || '').toLowerCase();
                    const specNm = (row.spec_nm || '').toLowerCase();
                    keywordMatch = rsceNm.includes(keyword) || specNm.includes(keyword);
                }

                // 공급유형 필터
                let supplyMatch = true;
                if (supplyType === '관급') {
                    supplyMatch = row.govsply_mtrl_yn === 'Y';
                } else if (supplyType === '사급') {
                    supplyMatch = row.govsply_mtrl_yn === 'N';
                }

                return keywordMatch && supplyMatch;
            });

            leftMaterialGrid.resetData(filtered);
        }

        // 장비 키워드 검색 필터링
        function filterExpenses() {
            const keyword = $('#expensesSearchText').val().trim().toLowerCase();

            // 원본 데이터를 기반으로 필터링
            const filtered = oriFilterE.filter(row => {
                // 키워드 조건
                let keywordMatch = true;
                if (keyword) {
                    const rsceNm = (row.rsce_nm || '').toLowerCase();
                    const specNm = (row.spec_nm || '').toLowerCase();
                    keywordMatch = rsceNm.includes(keyword) || specNm.includes(keyword);
                }

                return keywordMatch;
            });

            leftExpensesGrid.resetData(filtered);
        }

        // 오늘 하루 보지 않기 설정 함수
        function initHideActivityCheckbox() {
            const $checkbox = $('#hideActivityCheckbox');
            const savedTime = localStorage.getItem('hideActivityPage');

            // 페이지 로드 시 상태 복원
            if (savedTime && Date.now() < savedTime) {
                $checkbox.prop('checked', true);
            } else {
                localStorage.removeItem('hideActivityPage');
                $checkbox.prop('checked', false);
            }

            // 체크박스 변경 시 이벤트 바인딩
            $checkbox.on('change', function () {
                if ($(this).is(':checked')) {
                    const expireDate = new Date();
                    expireDate.setHours(23, 59, 59, 999); // 오늘 밤 11:59:59까지
                    localStorage.setItem('hideActivityPage', expireDate.getTime());
                } else {
                    localStorage.removeItem('hideActivityPage');
                }
            });
        }

        function initData() {
            const param = {
                cntrctNo: cntrctNo,
                dailyReportId: rId,
                workDtType: 'TD',
                dailyReportDate: drDt,
                planStart: $("#sDate").val(),
                planFinish: $("#eDate").val(),
                searchText: $("#searchText").val()
            }
            gaiaCommon.post(
                BASEPATH + 'dailyreport/dailyreport-chg',
                param,
                function (response) {
                    const details = (response && response.details) || {};
                    let activityData = details.prActivityList || [];
                    let todayActivityData = details.todayDailyReportActivityList || [];
                    oriActivityData = [...todayActivityData];   // 원본 저장

                    // activityGrid 데이터 중 todayGrid에 없는 항목만 필터링
                    const todayIds = new Set(todayActivityData.map(item => item.activity_id));
                    const filteredActivityData = activityData.filter(
                        item => !todayIds.has(item.activity_id)
                    );

                    // 액티비티 목록
                    activityGrid.resetData(filteredActivityData);
                    refreshGrid(activityGrid);
                    oriFilterAct = [...filteredActivityData]   // 검색 필터에 사용

                    // 금일 액티비티 목록
                    // ★ 상태별 별 세팅
                    const dataWithStars = setStatusStars(todayActivityData);
                    todayGrid.resetData(dataWithStars);

                    // 모든 행 체크 상태로 초기화
                    todayGrid.getData().forEach(row => {
                      todayGrid.check(row.rowKey);
                    });

                    refreshGrid(todayGrid);
                    todayGrid.refreshLayout();

                    // 실제 데이터도 세팅, formatter은 보여주기만 하고 실제 데이터에 저장하진 않음
                    const data = todayGrid.getData();
                    data.forEach((row, index) => {
                        if ((row.bgn || row.ing || row.end)) {
                            if(row.actual_start) {
                                todayGrid.setValue(index, 'actual_bgn_date', row.actual_start, false);
                            } else {
                                todayGrid.setValue(index, 'actual_bgn_date', drDt, false);
                            }
                        }
                        if (row.end) {
                            if(row.actual_finish) {
                                todayGrid.setValue(index, 'actual_end_date', row.actual_finish, false);
                            } else  {
                                todayGrid.setValue(index, 'actual_end_date', drDt, false);
                            }
                        }
                    });

                    initResourceData(todayActivityData);

                },
                function (error) {
                    gaiaCommon.customAlert("{{ message('msg.060') }}");
                }
            );
        }

        // 자원 데이터 세팅
        function initResourceData(todayActivityData) {
            // activity_id & today_bohal 쌍만 추출해서 activityIdAndTodayBohal 배열 생성
            const activityIdAndTodayBohal = (todayActivityData || []).map(item => ({
                activityId: item.activity_id,
                todayBohal: item.today_bohal
            }));

            const param = {
                cntrctNo: cntrctNo,
                dailyReportId: rId,
                activityIdAndTodayBohal: activityIdAndTodayBohal
            };
            gaiaCommon.post(
                BASEPATH + 'dailyreport/dailyreport-today-resource',
                param,
                function (response) {
                    const details = (response && response.details) || {};
                    let activityResData = details.todayResourceList || [];
                    let todayResourceData = details.todayDailyReportResourceList || [];
                    oriResourceData = [...todayResourceData];

                    // rsce_tp_cd 앞글자 기준 분류
                    const laborList = [];
                    const materialList = [];
                    const expensesList = [];
                    const todayLaborList = [];
                    const todayMaterialList = [];
                    const todayExpensesList = [];

                    // 오른쪽 그리드 자원 목록 분류 (기준)
                    todayResourceData.forEach(item => {
                        const type = (item.rsce_tp_cd || '').substring(0, 1);
                        if (type === 'L') todayLaborList.push(item);
                        else if (type === 'M') todayMaterialList.push(item);
                        else if (type === 'E') todayExpensesList.push(item);
                    });

                    // L 계열 정렬: LS 먼저
                    todayLaborList.sort((a, b) => {
                        const aCd = a.rsce_tp_cd || '';
                        const bCd = b.rsce_tp_cd || '';

                        if (aCd.startsWith('LS') && !bCd.startsWith('LS')) return -1; // a=LS → 위로
                        if (!aCd.startsWith('LS') && bCd.startsWith('LS')) return 1;  // b=LS → 위로
                        return aCd.localeCompare(bCd); // 나머지는 알파벳순
                    });

                    // 오른쪽 그리드 기준으로 중복 필터링용 Set 생성
                    const todayLaborKeySet = new Set(todayLaborList.map(i => `${i.rsce_cd}_${i.govsply_mtrl_yn}`));
                    const todayMaterialKeySet = new Set(todayMaterialList.map(i => `${i.rsce_cd}_${i.govsply_mtrl_yn}`));
                    const todayExpensesKeySet = new Set(todayExpensesList.map(i => `${i.rsce_cd}_${i.govsply_mtrl_yn}`));

                    // 왼쪽 그리드 자원 목록 분류 및 중복 제거
                    activityResData.forEach(item => {
                        const type = (item.rsce_tp_cd || '').substring(0, 1);
                        const key = `${item.rsce_cd}_${item.govsply_mtrl_yn || ''}`;
                        if (type === 'L' && !todayLaborKeySet.has(key)) {
                            laborList.push(item);
                        } else if (type === 'M' && !todayMaterialKeySet.has(key)) {
                            materialList.push(item);
                        } else if (type === 'E' && !todayExpensesKeySet.has(key)) {
                            expensesList.push(item);
                        }
                    });

                    // 인력
                    leftLaborGrid.resetData(laborList);
                    rightLaborGrid.resetData(todayLaborList);
                    if (leftLaborGrid.refreshLayout) leftLaborGrid.refreshLayout();
                    if (rightLaborGrid.refreshLayout) rightLaborGrid.refreshLayout();
                    reportRefreshGrid(leftLaborGrid);
                    reportRefreshGrid(rightLaborGrid);
                    // 모든 행 체크
                    rightLaborGrid.getData().forEach(row => {
                        rightLaborGrid.check(row.rowKey);
                    });
                    oriFilterL = [...laborList];

                    // 자재
                    leftMaterialGrid.resetData(materialList);
                    rightMaterialGrid.resetData(todayMaterialList);
                    if (leftMaterialGrid.refreshLayout) leftMaterialGrid.refreshLayout();
                    if (rightMaterialGrid.refreshLayout) rightMaterialGrid.refreshLayout();
                    reportRefreshGrid(leftMaterialGrid,);
                    reportRefreshGrid(rightMaterialGrid);
                    // 모든 행 체크
                    rightMaterialGrid.getData().forEach(row => {
                        rightMaterialGrid.check(row.rowKey);
                    });
                    oriFilterM = [...materialList];

                    // 장비
                    leftExpensesGrid.resetData(expensesList);
                    rightExpensesGrid.resetData(todayExpensesList);
                    if (leftExpensesGrid.refreshLayout) leftExpensesGrid.refreshLayout();
                    if (rightExpensesGrid.refreshLayout) rightExpensesGrid.refreshLayout();
                    reportRefreshGrid(leftExpensesGrid);
                    reportRefreshGrid(rightExpensesGrid);
                    // 모든 행 체크
                    rightExpensesGrid.getData().forEach(row => {
                        rightExpensesGrid.check(row.rowKey);
                    });
                    oriFilterE = [...expensesList];
                },
                function (error) {
                    gaiaCommon.customAlert("{{ message('msg.060') }}");
                }
            );
        }

        function addOrUpdateActAndRes() {
            // 체크박스 체킹된 액티비티, 자원 수집
            const checkedActivities = getCheckedRows(todayGrid);
            const checkedLabors = getCheckedRows(rightLaborGrid);
            const checkedMaterials = getCheckedRows(rightMaterialGrid);
            const checkedExpenses = getCheckedRows(rightExpensesGrid);

            // 삭제항목 색출(dlt_yn:Y 로 교체)
            const mergedActivitiesRaw = mergeDeletedItems(oriActivityData, checkedActivities, 'activity_id');
            const mergedResourcesRaw = mergeDeletedItems(oriResourceData, [
              ...checkedLabors,
              ...checkedMaterials,
              ...checkedExpenses
            ], 'rsce_cd');

            // 서버 전달용으로 param 셋팅
            const mappedActivities = mapActivityRowsToList(mergedActivitiesRaw, cntrctNo, rId, 'TD');
            const mappedResources  = mapResourceRowsToList(mergedResourcesRaw, cntrctNo, rId);

            const param = {
                cntrctNo: cntrctNo,
                dailyReportId: rId,
                dailyReportActivity: mappedActivities,
                dailyReportResource: mappedResources
            };
            gaiaCommon.post(
                BASEPATH + 'dailyreport/add-update-act-res',
                param,
                function (response) {
                    if(response.details.resultMsg == 'SUCCESS') {
                        window.location.href = "/construction/dailyreport/update"+`?rId=${rId}&pjtNo=${pjtInfo.pjtNo}&cntrctNo=${pjtInfo.cntrctNo}`;
                        sessionStorage.setItem('cntrctNo', cntrctNo);
                    } else {
                        gaiaCommon.customAlert("{{ message('msg.060') }}");
                    }
                },
                function (error) {
                    gaiaCommon.customAlert("{{ message('msg.060') }}");
                }
            );
        }
        window.addEventListener('resize', () => {
          activityGrid.refreshLayout();
        });
        $("#cancel").click(function () {
            window.location.href = "/construction/dailyreport/update"+`?rId=${rId}&pjtNo=${pjtInfo.pjtNo}&cntrctNo=${pjtInfo.cntrctNo}&_condition=init`;
            sessionStorage.setItem('cntrctNo', cntrctNo);
        });
        $("#save").click(function () {
            addOrUpdateActAndRes();
        });
        $(document).ready(()=>{
            gaia.create({
                $init: function ($params) {
                    gaiaPortal.navMenuInit('M0401', "{{ message('item.construction.901') }}" + " 금일 액티비티 " + "{{ message('btn.003') }}");
                    $("#menuDepth").append('<li class=\"breadcrumb_item\" name=\"new_item\">{{ message("item.construction.901") }}  금일 액티비티 {{ message("btn.003") }}</li>');
                }
            });

            // 액티비티 검색
            $('#searchText').on('keypress', function (e) {
                if (e.which === 13) { // Enter key
                    filterActivity();
                }
            });
            $('#searchBtn').on('click', function () {
                filterActivity();
            });

            // 인력 검색
            $('#laborSearchText').on('keypress', function (e) {
                if (e.which === 13) { // Enter key
                    filterLabor();
                }
            });
            $('#laborSearchBtn').on('click', function () {
                filterLabor();
            });

            // 자재 검색
            $('#materialSearchText').on('keypress', function (e) {
                if (e.which === 13) { // Enter key
                    filterMaterial();
                }
            });
            $('#materialSearchBtn').on('click', function () {
                filterMaterial();
            });
            $('#matSupply').on('change', filterMaterial);

            // 장비 검색
            $('#expensesSearchText').on('keypress', function (e) {
                if (e.which === 13) { // Enter key
                    filterExpenses();
                }
            });
            $('#expensesSearchBtn').on('click', function () {
                filterExpenses();
            });

            // 오늘 하루 보지 않기
            initHideActivityCheckbox();
            initData();
        });

        let reportRefreshGrid = function (...grids) {
            const _section = document.getElementById("content")

            if (!_section) return;

            let timer;
            const resizeObserver = new ResizeObserver(() => {
                clearTimeout(timer);

                timer = setTimeout(() => {
                    for (const grid of grids) {
                        if (!grid || !(grid instanceof tui.Grid)) continue;

                        const dataWidth = Number(elem.el.getAttribute("data-width"));

                        grid.el.setAttribute("data-width", dataWidth);

                        const newWidth = dataWidth;

                        // 🔸 1. DOM width 직접 반영 (즉시 반응)
                        grid.el.style.width = `${newWidth}px`;
                        grid.refreshLayout()
                    }
                }, 10);
            });

            resizeObserver.observe(_section);
        };
    </script>
{% endblock footer_script %}