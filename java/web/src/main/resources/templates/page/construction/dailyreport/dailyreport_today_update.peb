        // 추가 버튼 클릭 시
        document.getElementById('btnAddMaterial').addEventListener('click', () => {
            const selectedRows = leftMaterialGrid.getCheckedRows();
            if (selectedRows.length === 0) {
                gaiaCommon.customAlert("이동할 데이터를 선택하세요.");
                return;
