<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no" />
    <link rel="stylesheet" href="/assets/mo/css/main.css" />
    <link rel="stylesheet" href="/assets/mo/css/custom.css" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>{{ envMode != null and envMode != "prod" ? "[" + envMode + "] " : "" }} {{ title != null ? title : "GAIA-CMIS" }}</title>
    <script src="https://cdn.jsdelivr.net/npm/handlebars@latest/dist/handlebars.js"></script>
    <script src="https://unpkg.com/dayjs"></script>

    <!-- 암호화 s -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/crypto-js/4.1.1/crypto-js.js"></script>
    <script src="/assets/js/common/crypto.common.js"></script>

    <script src="/assets/static/tware/tware.class.js"></script>
    <script src="/assets/mo/js/common/handlebars.common.js"></script>
    <script src="/assets/mo/js/jquery.min.js"></script>
    <script src="/assets/mo/js/browser.min.js"></script>
    <script src="/assets/mo/js/breakpoints.min.js"></script>
    <script src="/assets/mo/js/util.js"></script>
    <script src="/assets/js/gaia_common.js"></script>
    <script src="/assets/mo/js/gaia-cairos-mo.js"></script>
    <script>
        const uuid = gaia.generateUUID();

        const CRYPTO_CONFIG = {
            iv: '{{ crypto.iv }}',
            salt: '{{ crypto.salt }}',
            secretKey: '{{ crypto.secretKey }}',
            keySize: '{{ crypto.keySize }}',
            iterationCount: '{{ crypto.iterationCount }}'
        };

        Object.freeze(CRYPTO_CONFIG);


        /* 플랫폼 구분 전역 상수 */
        const PLATFORM = {
            CURRENT: `{{ platform != null ? platform : "GAIA---CMIS" }}`.toUpperCase(),  // 현재 접속 플랫폼 PGAIA -> GAIA로 변경됨!!
            TYPE: `{{ platform != null ? platform : "GAIA---CMIS" }}`.toUpperCase(),  // 현재 접속 플랫폼
            GAIA: `{{ gaia }}`.toUpperCase(),     // GAIA
            CAIROS: `{{ cairos }}`.toUpperCase()  // CMIS
        }
        if (PLATFORM.CURRENT === 'PGAIA') PLATFORM.CURRENT = PLATFORM.GAIA;
        Object.freeze(PLATFORM);

        const me = '{{ me }}';

        const generateCommonHeaders = (url, remoteAddr) => {
            // const commonData = JSON.parse( await sessionStorage.getItem('pageCommonData') || "{}" );

            return {
                platform: PLATFORM.CURRENT
                , requestUrl: url
                , requestId: uuid
                , remoteAddr: remoteAddr
                , userId: gaiaCommon.me.info ? gaiaCommon.me.info.usrId : ''
                , dateTime: dayjs().format('YYYYMMDDHHmmss')
                , referer: location.pathname
                , pjtNo: pjtNo
                , cntrctNo: cntrctNo
            };
        }
    </script>
</head>

<body class="is-preload">
    <div id="wrapper">
        {% block content %}{% endblock %}
    </div>

    <div id="preloader" style="display:none;"></div>

    <script>
        let params = {};
        let projectInfo = {};

        $(function () {
            $.ajaxPrefilter(function (options, originalOptions, jqXHR) {
                options.timeout = 1000 * 60 * 60;

                const v = JSON.stringify(generateCommonHeaders(options.url, jqXHR.remoteAddr));
                console.log('stringify', v);
                jqXHR.setRequestHeader("REQUEST_COMMON_HEADER", v);
            });

            gaia.create({
                $init: function ($args) {
                    console.log('$args', $args);
                    tware.utils.loadScript('/assets/mo/js/main.js');
                    gaia.loaded = true

                    if ($args.data.pjtNo != null) {
                        gaiaCommon.get(`/api/board/mainFaqList`, {}, function (res) {
                            projectInfo = res.details;
                        });
                    }
                }
            });
        });
    </script>
</body>
</html>